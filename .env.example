# Copy to .env and fill in. Never share or commit .env.
BOT_TOKEN=123456:ABC...
# 1 = charge the Telegram Stars prices in data/prices.json; 0 = everything free
PAYMENTS=0
# Shown by /paysupport, e.g. @your_username or an email address
SUPPORT_CONTACT=@your_username
# Your Telegram user id(s), comma separated; they can use /refund <charge id>
ADMIN_IDS=
